rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Content collections: public read, permissive write ----
    // The app has no server-side write path (ingestion runs from the
    // browser), so these cannot be locked to authenticated writers without
    // breaking guest comments/reactions and client-side ingestion. Shape
    // validation below is the available mitigation.
    match /news/{articleId} {
      allow read: if true;
      allow write: if request.resource.data.title is string
                   && request.resource.data.title.size() < 500;
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if request.resource.data.name is string
                   && request.resource.data.name.size() < 200;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if request.resource.data.articleId is string
                   && request.resource.data.userId is string
                   && request.resource.data.text is string
                   && request.resource.data.text.size() > 0
                   && request.resource.data.text.size() < 2000;
    }

    match /article_reactions/{articleId} {
      allow read: if true;
      allow write: if request.resource.data.likes is int
                   && request.resource.data.dislikes is int
                   && request.resource.data.likedBy is list
                   && request.resource.data.dislikedBy is list
                   && request.resource.data.likedBy.size() < 10000
                   && request.resource.data.dislikedBy.size() < 10000;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // ---- Market/macro data (Phase 2+): public read, ingestion writes ----
    match /market_series/{symbol} {
      allow read: if true;
      allow write: if true;
    }

    match /market_snapshot/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /market_movers/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /macro/{indicatorId} {
      allow read: if true;
      allow write: if true;
    }

    match /calendars/{calendarId} {
      allow read: if true;
      allow write: if true;
    }

    match /symbols/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /fundamentals/{symbol} {
      allow read: if true;
      allow write: if true;
    }

    // ---- Ingestion coordination (Phase 1): tightly shaped ----
    // These back the distributed lock and daily quota ledger that keep
    // multiple open tabs/visitors from each spending API calls. Field
    // allow-lists prevent an unauthenticated writer from corrupting the
    // lock/quota shape or ballooning document size.
    match /system/ingest_lock {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['holder', 'acquiredAt', 'leaseExpiresAt'])
                   && request.resource.data.holder is string
                   && request.resource.data.holder.size() < 100;
    }

    // Parent anchor doc for the subcollections below (never written directly).
    match /system/state {
      allow read: if true;
      allow write: if false;
    }

    match /system/state/quota/{date} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['used', 'budget', 'exhaustedAt'])
                   && request.resource.data.used is int
                   && request.resource.data.used >= 0
                   && request.resource.data.used <= 1000
                   && request.resource.data.budget is int;
    }

    match /system/state/datasets/{datasetId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(
                     ['lastFetchedAt', 'lastStatus', 'lastError', 'disabled', 'rotationIndex']
                   )
                   && (!('lastError' in request.resource.data)
                       || request.resource.data.lastError.size() < 500);
    }

    match /system/state/fetch_queue/{requestId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['symbol', 'requestedAt', 'status'])
                   && request.resource.data.symbol is string
                   && request.resource.data.symbol.size() < 20;
    }

    // Everything else denied by default.
  }
}
